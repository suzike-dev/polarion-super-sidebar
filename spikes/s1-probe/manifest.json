{
  "manifest_version": 3,
  "name": "Polarion Sidebar S1 Probe",
  "version": "0.1.0",
  "description": "Isolated capability probe for the approved Polarion sidebar project",
  "key": "",
  "permissions": [
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://polarion.pufafen.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "probe.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://polarion.pufafen.com/polarion/*"
      ],
      "js": [
        "context.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}